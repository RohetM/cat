# CatalogIQ – Environment Variables
# Copy this file to .env and fill in your secrets

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=CatalogIQ
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./catalogiq.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/catalogiq

# ── LLM Keys (configure at least one) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Pipeline ─────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.85
BATCH_CONCURRENCY=10
MAX_UPLOAD_BYTES=52428800  # 50 MB

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
